# ==========================================
# CONFIGURACIÓN DE ENTORNO - PLANTILLA E-COMMERCE
# ==========================================

# 1. SUPABASE (Base de Datos y Bucket de Imágenes .webp)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. RUTA ADMINISTRATIVA OCULTA (Personalizable por cliente)
NEXT_PUBLIC_ADMIN_ROUTE_PATH=/portal-admin-secure

# 3. BLUE EXPRESS CHILE (Logística y Seguimiento de Envíos)
BLUEXPRESS_API_URL=https://api.blue.cl/v1
BLUEXPRESS_API_KEY=tu_api_key_bluexpress
BLUEXPRESS_CLIENT_CODE=tu_codigo_cliente_pyme

# 4. PASARELA DE PAGOS (Webpay / Flow / Mercado Pago)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxx-xxxxxx-xxxx-xxxxxxxxx
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxxx-xxxxxx-xxxx-xxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=tu_secreto_de_webhook_firmado

# 5. CONFIGURACIÓN GENERAL DEL COMERCIO
NEXT_PUBLIC_SITE_NAME="Tienda Demo"
NEXT_PUBLIC_SITE_URL=https://mitienda.cl
NEXT_PUBLIC_CURRENCY=CLP
